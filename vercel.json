{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/insightnovatech-v2", "destination": "/index.html" },
    { "source": "/insightnovatech-v2.html", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|svg|ico|webp)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
